# Generat per eines/construeix.py — no l'editeu a mà
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset utf-8
AddType application/manifest+json .webmanifest
AddType image/avif .avif
AddType image/webp .webp
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  Header always set X-Frame-Options "DENY"
  Header always set Strict-Transport-Security "max-age=31536000"
  <If "%{REQUEST_URI} !~ m#^/admin/#">
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://gary201.github.io; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://files.fcf.cat https://tcequipacions.cat; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
  </If>
  <If "%{REQUEST_URI} =~ m#^/admin/#">
    Header always set X-Robots-Tag "noindex, nofollow"
  </If>
  <FilesMatch "\.(woff2|woff)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|avif|jpg|jpeg|png|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml application/manifest+json
</IfModule>
# Fitxers de treball que no s'han de servir
<FilesMatch "^(package(-lock)?\.json|netlify\.toml|_headers|_redirects|LLEGEIX-ME\.txt)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 ^/(eines|src|docs|node_modules|\.github)(/|$)
